@model RoomBookingApp.Models.Booking
@{
    ViewData["Title"] = "Input Booking Ruangan";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h4>Form Input Booking Ruangan</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Ruangan</label>
                        <select asp-for="RoomId" class="form-select" asp-items="ViewBag.RoomId">
                            <option value="">-- Pilih Ruangan --</option>
                        </select>
                        <span asp-validation-for="RoomId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Tanggal Booking</label>
                        <input asp-for="BookingDate" class="form-control" type="date" />
                        <span asp-validation-for="BookingDate" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Catatan / Keperluan (Opsional)</label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Contoh: Rapat koordinasi tim"></textarea>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">Kembali</a>
                        <button type="submit" class="btn btn-success">Simpan Booking</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>